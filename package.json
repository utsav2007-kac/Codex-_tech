{
  "name": "codex-tech-it-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "db:migrate": "npm run prisma:migrate --workspace=server",
    "db:seed": "npm run seed --workspace=server",
    "db:reset": "npm run prisma:reset --workspace=server",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "e2e": "npm run test --workspace=e2e",
    "check:links": "node scripts/check-links.mjs",
    "audit:space": "node scripts/whitespace-audit.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
